# Machine-local production TTS config (Companion UI read-back).
# Copy to .env.prod.local on the runtime host; NEVER commit the real file.
# Docker Compose reads these for ${...} substitution in docker-compose.yaml (api service).
#
# External-SSD root holding models/, cache/, logs/. Bind-mounted to /data/tts in the
# container; the app sees TTS_MODEL_DIR=/data/tts/models etc. See
# companion-ui/docs/LOCAL_FIRST_TTS_CONTRACT.md and docs/runbooks/RUNBOOK_TTS_PROVISIONING.md.
TTS_HOST_ROOT=/Volumes/T7/CompanionData/tts

# Turn the feature on ONLY after the model files exist on the SSD
# (scripts/fetch_tts_models.sh "$TTS_HOST_ROOT/models"); otherwise the API returns 503.
TTS_ENABLED=true

# Policy (defaults are already safe; shown for clarity)
TTS_LOCAL_ONLY=true
TTS_ALLOW_BROWSER_FALLBACK=false
TTS_ALLOW_CLOUD_FALLBACK=false
