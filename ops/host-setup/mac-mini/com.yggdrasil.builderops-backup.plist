<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yggdrasil.builderops-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BACKUP_WRAPPER__</string>
  </array>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BUILDEROPS_OPERATOR_ENV_FILE</key>
    <string>__OPERATOR_ENV__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/Shared/builderops/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/builderops/backup.err</string>
</dict>
</plist>
