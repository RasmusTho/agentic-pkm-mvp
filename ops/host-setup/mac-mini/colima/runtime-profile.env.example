# Non-secret candidate input for the managed-host installer. An operator must
# review and approve a real host binding before using it as authority.
COLIMA_RUNTIME_PROVIDER=colima
COLIMA_PROFILE=default
COLIMA_DOCKER_CONTEXT=colima
COLIMA_USERNET_TIMEOUT=120
LIMA_USERNET_TIMEOUT=120
COLIMA_EXPECTED_PERSISTENT_FSTYPE=ext4
# Operator must replace these placeholders with reviewed host values.
# COLIMA_EXPECTED_PERSISTENT_IDENTITY=UUID=<reviewed-filesystem-uuid>
# COLIMA_EXPECTED_PERSISTED_INVENTORY=<reviewed-container-count>
COLIMA_MIN_FREE_BLOCKS=1048576
COLIMA_MIN_FREE_INODES=16384
COLIMA_PERSISTENT_DATA_PATH=/var/lib/yggdrasil-persistent
COLIMA_DOCKER_DATA_PATH=/var/lib/docker
COLIMA_CONTAINERD_DATA_PATH=/var/lib/containerd
COLIMA_PERSISTED_CONFIG_ROOT=/var/lib/docker/containers
