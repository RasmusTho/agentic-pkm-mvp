<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yggdrasil.builderops-probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__PROBE__</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BUILDEROPS_PROBE_BASE_URL</key>
    <string>http://127.0.0.1:18100</string>
    <key>BUILDEROPS_PROBE_TOKEN_FILE</key>
    <string>__PROBE_TOKEN__</string>
    <key>BUILDEROPS_PROBE_STATE_FILE</key>
    <string>/Users/Shared/builderops/probe-state.json</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/Shared/builderops/probe.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/builderops/probe.err</string>
</dict>
</plist>
