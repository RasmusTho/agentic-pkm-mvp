# ── Yggdrasil two-box host setup — shared config ──────────────────────────────
# Copy this file to `config.env` and edit. The install scripts AND the per-machine
# agent playbooks read these values, so set them once here.
#
# Hostnames are Tailscale MagicDNS names. If MagicDNS is enabled you can use the
# short name (e.g. "gaming-pc"); otherwise use the full "<name>.<tailnet>.ts.net"
# name or the 100.x.y.z tailnet IP.

# ── Tailnet hosts ─────────────────────────────────────────────────────────────
MAC_MINI_HOST=mac-mini
GAMING_PC_HOST=gaming-pc

# ── Ports ─────────────────────────────────────────────────────────────────────
MINI_OLLAMA_PORT=11434     # Ollama on the mini (embeddings + small always-on chat)
GAMING_OLLAMA_PORT=11434   # Ollama on the gaming PC (fast burst chat)
GATEWAY_PORT=11500         # llm-gateway on the mini — THIS is Yggdrasil's OLLAMA_URL
WARDEN_PORT=9090           # gpu-warden on the gaming PC

# ── Models ────────────────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text:latest   # PINNED to the mini, must never move
MINI_CHAT_MODEL=llama3.1:8b           # always-on baseline chat (runs while you game)
GAMING_CHAT_MODEL=gpt-oss:20b         # fast MoE burst model for the RX 9070 XT
GAMING_HEAVY_MODEL=qwen3:30b-a3b      # optional heavier MoE (pull only if you want it)

# ── gpu-warden behaviour ──────────────────────────────────────────────────────
WARDEN_GPU_BUSY_PCT=25      # GPU 3D-util at/above this = "in use" -> keep chat local
WARDEN_GAME_PROCESSES=      # comma-separated game .exe names, e.g. cs2.exe,bg3.exe
WARDEN_RECLAIM_IDLE=0       # 1 = allow closing an IDLE listed game to reclaim the GPU
WARDEN_RECLAIM_IDLE_MIN=20  # minutes with no keyboard/mouse input before reclaim
