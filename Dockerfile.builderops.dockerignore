# Builder-only build context. These are the inputs copied by Dockerfile.builderops;
# Product's shared .dockerignore intentionally excludes this document closure.
**
!pyproject.toml
!requirements-builderops.txt
!AGENTS.md
!app
!app/**
!scripts
!scripts/validate_issue_readiness.py
!tests/
!tests/fixtures/
!tests/fixtures/issue_readiness/
!tests/fixtures/issue_readiness/valid_ready_candidate.md
!.codex
!.codex/agents
!.codex/agents/slice-implementer.toml
!.codex/skills
!.codex/skills/start-model-inquiry
!.codex/skills/start-model-inquiry/SKILL.md
!docs
!docs/**
!docs/settings
!docs/settings/models
!docs/settings/models/providers.yaml
!config
!config/platform
!config/platform/builderops_vm_rebuild_activation.v1.schema.json
!config/platform/devsystem_vm102_component_inventory.v1.schema.json
!config/platform/devui_vm102_runtime_qualification.v1.schema.json
!config/platform/devsystem_vm102_deploy.v1.schema.json
!config/platform/devsystem_vm102_health.v1.schema.json
!config/platform/devui_first_read_observation.v1.schema.json
**/__pycache__
**/*.pyc
**/*.log
**/*.jsonl

!companion-ui
!companion-ui/companion-app
!companion-ui/companion-app/companion_ui
!companion-ui/companion-app/companion_ui/workspace
!companion-ui/companion-app/companion_ui/workspace/devui_candidate
!companion-ui/companion-app/companion_ui/workspace/devui_candidate/*
