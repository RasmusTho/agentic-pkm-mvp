{
  "schema": "temporal-posture-policy.v1",
  "version": "temporal-posture.v1",
  "owner": "Product / cognitive support",
  "effective_at": "2026-07-13T00:00:00Z",
  "allowlist": [
    {
      "kind": "external_source",
      "mode": "age_review",
      "permitted_timestamp_fields": [
        "source_updated_at",
        "source_published_at"
      ],
      "review_interval_days": 180,
      "rationale": "Invite review of explicitly dated external source material without judging validity."
    },
    {
      "kind": "external_projection",
      "mode": "age_review",
      "permitted_timestamp_fields": [
        "source_observed_at"
      ],
      "review_interval_days": 90,
      "rationale": "Expose review timing for projections only when their source observation time is explicit."
    },
    {
      "kind": "historical_external_source",
      "mode": "historical",
      "permitted_timestamp_fields": [],
      "review_interval_days": null,
      "rationale": "Preserve policy-designated historical context without aging it into a review-due claim."
    }
  ]
}
