POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HEALTHCHECK_HOST=localhost
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
DB_DSN=postgresql+psycopg://app:app@db:5432/app
STORE_BACKEND=pg
LLM_PROVIDER_ENFORCE=1
LLM_MODEL=llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://ollama:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
EMBED_MODEL=nomic-embed-text:latest
EMBED_DIM=768
EMBED_NORMALIZE=1
WATCHER_ENABLE=1
WATCHER_AUTO_EXEC=1
WATCHER_VAULT_PATH=/app/vault
WATCHER_HEARTBEAT_PATH=/app/tmp/watcher_heartbeat.json
WORKER_HEARTBEAT_PATH=/app/tmp/worker_heartbeat.json
WATCHER_STATE_PATH=/app/tmp/watcher_state.json
WATCHER_STATE_DIR=tmp
WATCHER_STOP_FILE=/app/tmp/WATCHER_STOP
WATCHER_MAX_SCANNED_FILES_PER_TICK=500
INDEX_OUTBOX_PATH=/app/tmp/index-outbox.jsonl
API_HEALTHCHECK_URL=http://127.0.0.1:8000/api/status
# v6.0 canvas seam — deliberately gated until canvas feature is stable enough for default-on
CANVAS_ENABLED=0
