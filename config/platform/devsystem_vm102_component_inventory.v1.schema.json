{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devsystem_vm102_component_inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "receipt_version",
    "target_vm",
    "observed_at",
    "source_refs",
    "components",
    "secret_material",
    "gaps",
    "refusals",
    "claims",
    "component_inventory_digest",
    "evidence_fingerprints",
    "evidence_fingerprint"
  ],
  "properties": {
    "receipt_type": {"const": "devsystem_vm102_component_inventory.v1"},
    "receipt_version": {"const": 1},
    "target_vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vmid", "name"],
      "properties": {
        "vmid": {"const": 102},
        "name": {"const": "builder-system"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_ref"},
      "allOf": [
        {"contains": {"const": "repo:docs/BUILDEROPS_CONTROL_PLANE/README.md#complete-dev-system-vm-102-topology-contract"}},
        {"contains": {"const": "github:issue:5194"}}
      ]
    },
    "components": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "devui_projection"}, "owner": {"const": "owner:dev_ui"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "builderops_control_plane"}, "owner": {"const": "owner:builderops"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "builderops_cockpit"}, "owner": {"const": "owner:builderops_cockpit"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "dispatcher_signboard"}, "owner": {"const": "owner:dispatcher_signboard"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "ddo"}, "owner": {"const": "owner:ddo"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "ckm_kvasir"}, "owner": {"const": "owner:ckm_kvasir"}}},
        {"$ref": "#/$defs/vm102_gap_component", "properties": {"component_id": {"const": "focus_conversation_port"}, "owner": {"const": "owner:focus_conversation_port"}}},
        {"$ref": "#/$defs/external_gap_component", "properties": {"component_id": {"const": "soi_evidence"}, "owner": {"const": "owner:product_runtime"}}},
        {"$ref": "#/$defs/external_component", "properties": {"component_id": {"const": "github_git_ci_delivery"}, "owner": {"const": "owner:github_git_ci"}}},
        {"$ref": "#/$defs/external_gap_component", "properties": {"component_id": {"const": "model_service"}, "owner": {"const": "owner:model_access_substrate"}}},
        {"$ref": "#/$defs/external_gap_component", "properties": {"component_id": {"const": "tars_proxmox_control"}, "owner": {"const": "owner:tars_proxmox"}}},
        {"$ref": "#/$defs/excluded_component", "properties": {"component_id": {"const": "product_runtime"}, "owner": {"const": "owner:product_runtime"}}}
      ],
      "items": false
    },
    "secret_material": {"const": "absent"},
    "gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gap"}
    },
    "refusals": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "activation_not_proven",
          "deployment_not_proven",
          "health_not_proven",
          "qualification_not_proven",
          "residency_not_proven",
          "rollback_not_proven"
        ]
      },
      "allOf": [
        {"contains": {"const": "activation_not_proven"}},
        {"contains": {"const": "deployment_not_proven"}},
        {"contains": {"const": "health_not_proven"}},
        {"contains": {"const": "qualification_not_proven"}},
        {"contains": {"const": "residency_not_proven"}},
        {"contains": {"const": "rollback_not_proven"}}
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_complete",
        "residency_proven",
        "qualification_proven",
        "activation_proven",
        "deployment_proven",
        "health_proven",
        "rollback_proven"
      ],
      "properties": {
        "inventory_complete": {"const": true},
        "residency_proven": {"const": false},
        "qualification_proven": {"const": false},
        "activation_proven": {"const": false},
        "deployment_proven": {"const": false},
        "health_proven": {"const": false},
        "rollback_proven": {"const": false}
      }
    },
    "component_inventory_digest": {"$ref": "#/$defs/digest"},
    "evidence_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devui_projection",
        "builderops_control_plane",
        "builderops_cockpit",
        "dispatcher_signboard",
        "ddo",
        "ckm_kvasir",
        "focus_conversation_port",
        "soi_evidence",
        "github_git_ci_delivery",
        "model_service",
        "tars_proxmox_control",
        "product_runtime"
      ],
      "properties": {
        "devui_projection": {"$ref": "#/$defs/digest"},
        "builderops_control_plane": {"$ref": "#/$defs/digest"},
        "builderops_cockpit": {"$ref": "#/$defs/digest"},
        "dispatcher_signboard": {"$ref": "#/$defs/digest"},
        "ddo": {"$ref": "#/$defs/digest"},
        "ckm_kvasir": {"$ref": "#/$defs/digest"},
        "focus_conversation_port": {"$ref": "#/$defs/digest"},
        "soi_evidence": {"$ref": "#/$defs/digest"},
        "github_git_ci_delivery": {"$ref": "#/$defs/digest"},
        "model_service": {"$ref": "#/$defs/digest"},
        "tars_proxmox_control": {"$ref": "#/$defs/digest"},
        "product_runtime": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence_fingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ref": {
      "type": "string",
      "anyOf": [
        {"const": "repo:docs/BUILDEROPS_CONTROL_PLANE/README.md#complete-dev-system-vm-102-topology-contract"},
        {"const": "github:issue:5194"},
        {"pattern": "^github:pr:[1-9][0-9]*$"},
        {"pattern": "^github:commit:[a-f0-9]{40,64}$"},
        {"pattern": "^receipt:(devsystem_vm102_component_inventory\\.v1|builderops_vm_rebuild_activation\\.v1|devui_vm102_runtime_qualification\\.v1|devsystem_vm102_deploy\\.v1|devsystem_vm102_health\\.v1|devui-stage-a-read-only-owner-pilot\\.v1|devsystem_vm102_rollback\\.v1|tars_host_qualification\\.v1):[a-f0-9]{64}$"},
        {"pattern": "^operator:sha256:[a-f0-9]{64}$"}
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "placement_class",
        "owner",
        "service_or_project",
        "source_identity",
        "ingress_auth",
        "health_version",
        "deployment_lifecycle",
        "migration_rollback",
        "reconciliation_state",
        "evidence_refs"
      ],
      "properties": {
        "component_id": {"type": "string"},
        "placement_class": {
          "enum": [
            "vm102_resident_target",
            "external_dependency",
            "intentionally_non_runtime"
          ]
        },
        "owner": {"enum": [
          "owner:dev_ui",
          "owner:builderops",
          "owner:builderops_cockpit",
          "owner:dispatcher_signboard",
          "owner:ddo",
          "owner:ckm_kvasir",
          "owner:focus_conversation_port",
          "owner:product_runtime",
          "owner:github_git_ci",
          "owner:model_access_substrate",
          "owner:tars_proxmox"
        ]},
        "service_or_project": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_identity": {"type": "string", "minLength": 1, "maxLength": 2048},
        "ingress_auth": {"type": "string", "minLength": 1, "maxLength": 2048},
        "health_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "deployment_lifecycle": {"type": "string", "minLength": 1, "maxLength": 2048},
        "migration_rollback": {"type": "string", "minLength": 1, "maxLength": 2048},
        "reconciliation_state": {"enum": ["gap", "unknown", "external", "excluded"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_ref"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"reconciliation_state": {"const": "gap"}}},
          "then": {"properties": {
            "service_or_project": {"const": "gap:service_or_project_not_proven"},
            "source_identity": {"const": "gap:source_identity_not_proven"},
            "ingress_auth": {"const": "gap:ingress_auth_not_proven"},
            "health_version": {"const": "gap:health_version_not_proven"},
            "deployment_lifecycle": {"const": "gap:deployment_lifecycle_not_proven"},
            "migration_rollback": {"const": "gap:migration_rollback_not_proven"}
          }}
        },
        {
          "if": {"properties": {"reconciliation_state": {"const": "unknown"}}},
          "then": {"properties": {
            "service_or_project": {"const": "unknown:service_or_project_not_proven"},
            "source_identity": {"const": "unknown:source_identity_not_proven"},
            "ingress_auth": {"const": "unknown:ingress_auth_not_proven"},
            "health_version": {"const": "unknown:health_version_not_proven"},
            "deployment_lifecycle": {"const": "unknown:deployment_lifecycle_not_proven"},
            "migration_rollback": {"const": "unknown:migration_rollback_not_proven"}
          }}
        },
        {
          "if": {"properties": {"reconciliation_state": {"const": "external"}}},
          "then": {"properties": {
            "service_or_project": {"const": "external:service_or_project_external_dependency"},
            "source_identity": {"const": "external:source_identity_external_dependency"},
            "ingress_auth": {"const": "external:ingress_auth_external_dependency"},
            "health_version": {"const": "external:health_version_external_dependency"},
            "deployment_lifecycle": {"const": "external:deployment_lifecycle_external_dependency"},
            "migration_rollback": {"const": "external:migration_rollback_external_dependency"}
          }}
        },
        {
          "if": {"properties": {"reconciliation_state": {"const": "excluded"}}},
          "then": {"properties": {
            "service_or_project": {"const": "excluded:service_or_project_not_applicable"},
            "source_identity": {"const": "excluded:source_identity_not_applicable"},
            "ingress_auth": {"const": "excluded:ingress_auth_not_applicable"},
            "health_version": {"const": "excluded:health_version_not_applicable"},
            "deployment_lifecycle": {"const": "excluded:deployment_lifecycle_not_applicable"},
            "migration_rollback": {"const": "excluded:migration_rollback_not_applicable"}
          }}
        }
      ]
    },
    "vm102_gap_component": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "placement_class": {"const": "vm102_resident_target"},
            "reconciliation_state": {"enum": ["gap", "unknown"]}
          }
        }
      ]
    },
    "external_gap_component": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "placement_class": {"const": "external_dependency"},
            "reconciliation_state": {"enum": ["gap", "unknown"]}
          }
        }
      ]
    },
    "external_component": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "placement_class": {"const": "external_dependency"},
            "reconciliation_state": {"const": "external"}
          }
        }
      ]
    },
    "excluded_component": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "placement_class": {"const": "intentionally_non_runtime"},
            "reconciliation_state": {"const": "excluded"}
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "code", "detail"],
      "properties": {
        "component_id": {"enum": [
          "devui_projection",
          "builderops_control_plane",
          "builderops_cockpit",
          "dispatcher_signboard",
          "ddo",
          "ckm_kvasir",
          "focus_conversation_port",
          "soi_evidence",
          "github_git_ci_delivery",
          "model_service",
          "tars_proxmox_control",
          "product_runtime"
        ]},
        "code": {"enum": ["runtime_evidence_missing", "runtime_evidence_unknown"]},
        "detail": {"const": "runtime evidence is not supplied by this inventory"}
      }
    }
  }
}
