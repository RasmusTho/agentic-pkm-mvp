  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_ref": {
      "type": "string",
      "anyOf": [
        {
          "const": "repo:docs/BUILDEROPS_CONTROL_PLANE/README.md#complete-dev-system-vm-102-topology-contract"
        },
        {
          "const": "github:issue:5194"
        },
        {
          "pattern": "^github:pr:[1-9][0-9]*$"
        },
        {
          "pattern": "^github:commit:[a-f0-9]{40,64}$"
        },
        {
          "pattern": "^receipt:(devsystem_vm102_component_inventory\\.v1|builderops_vm_rebuild_activation\\.v1|devui_vm102_runtime_qualification\\.v1|devsystem_vm102_deploy\\.v1|devsystem_vm102_health\\.v1|devui-stage-a-read-only-owner-pilot\\.v1|devsystem_vm102_rollback\\.v1|tars_host_qualification\\.v1):[a-f0-9]{64}$"
        },
        {
          "pattern": "^operator:sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "placement_class",
        "owner",
        "service_or_project",
        "source_identity",
        "ingress_auth",
        "health_version",
        "deployment_lifecycle",
        "migration_rollback",
        "reconciliation_state",
        "evidence_refs"
      ],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "placement_class": {
          "enum": [
            "vm102_resident_target",
            "external_dependency",
            "intentionally_non_runtime"
          ]
        },
        "owner": {
          "enum": [
            "owner:dev_ui",
            "owner:builderops",
            "owner:builderops_cockpit",
            "owner:dispatcher_signboard",
            "owner:ddo",
            "owner:ckm_kvasir",
            "owner:focus_conversation_port",
            "owner:product_runtime",
            "owner:github_git_ci",
            "owner:model_access_substrate",
            "owner:tars_proxmox"
          ]
        },
        "service_or_project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "ingress_auth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "health_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "deployment_lifecycle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "migration_rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "reconciliation_state": {
          "enum": [
            "gap",
            "unknown",
            "external",
            "excluded"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reconciliation_state": {
                "const": "gap"
              }
            }
          },
          "then": {
            "properties": {
              "service_or_project": {
                "const": "gap:service_or_project_not_proven"
              },
              "source_identity": {
                "const": "gap:source_identity_not_proven"
              },
              "ingress_auth": {
                "const": "gap:ingress_auth_not_proven"
              },
              "health_version": {
                "const": "gap:health_version_not_proven"
              },
              "deployment_lifecycle": {
                "const": "gap:deployment_lifecycle_not_proven"
              },
              "migration_rollback": {
                "const": "gap:migration_rollback_not_proven"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reconciliation_state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "service_or_project": {
                "const": "unknown:service_or_project_not_proven"
              },
              "source_identity": {
                "const": "unknown:source_identity_not_proven"
              },
              "ingress_auth": {
                "const": "unknown:ingress_auth_not_proven"
              },
              "health_version": {
                "const": "unknown:health_version_not_proven"
              },
              "deployment_lifecycle": {
                "const": "unknown:deployment_lifecycle_not_proven"
              },
              "migration_rollback": {
                "const": "unknown:migration_rollback_not_proven"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reconciliation_state": {
                "const": "external"
              }
            }
          },
          "then": {
            "properties": {
              "service_or_project": {
                "const": "external:service_or_project_external_dependency"
              },
              "source_identity": {
                "const": "external:source_identity_external_dependency"
              },
              "ingress_auth": {
                "const": "external:ingress_auth_external_dependency"
              },
              "health_version": {
                "const": "external:health_version_external_dependency"
              },
              "deployment_lifecycle": {
                "const": "external:deployment_lifecycle_external_dependency"
              },
              "migration_rollback": {
                "const": "external:migration_rollback_external_dependency"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reconciliation_state": {
                "const": "excluded"
              }
            }
          },
          "then": {
            "properties": {
              "service_or_project": {
                "const": "excluded:service_or_project_not_applicable"
              },
              "source_identity": {
                "const": "excluded:source_identity_not_applicable"
              },
              "ingress_auth": {
                "const": "excluded:ingress_auth_not_applicable"
              },
              "health_version": {
                "const": "excluded:health_version_not_applicable"
              },
              "deployment_lifecycle": {
                "const": "excluded:deployment_lifecycle_not_applicable"
              },
              "migration_rollback": {
                "const": "excluded:migration_rollback_not_applicable"
              }
            }
          }
        }
      ]
    },
