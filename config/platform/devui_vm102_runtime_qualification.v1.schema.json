{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devui_vm102_runtime_qualification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "receipt_version",
    "target_vm",
    "component_id",
    "observed_at",
    "source_refs",
    "candidate_identity",
    "component_inventory_digest",
    "operator_evidence_digest",
    "topology",
    "runtime",
    "checks",
    "verdict",
    "secret_material",
    "gaps",
    "refusals",
    "evidence_fingerprint"
  ],
  "properties": {
    "receipt_type": {
      "const": "devui_vm102_runtime_qualification.v1"
    },
    "receipt_version": {
      "const": 1
    },
    "target_vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vmid",
        "name"
      ],
      "properties": {
        "vmid": {
          "const": 102
        },
        "name": {
          "const": "builder-system"
        }
      }
    },
    "component_id": {
      "const": "devui_projection"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(repo:docs/BUILDEROPS_CONTROL_PLANE/README[.]md#vm-102-evidence-and-receipt-contract|operator:sha256:[a-f0-9]{64}|receipt:[a-z0-9_.-]+:[a-f0-9]{64})$"
      }
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "control_plane_image_digest",
        "postgres_image_digest",
        "config_fingerprint",
        "devui_image_digest",
        "devui_config_fingerprint"
      ],
      "properties": {
        "source_sha": {
          "type": "string",
          "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
        },
        "control_plane_image_digest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
        },
        "postgres_image_digest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
        },
        "config_fingerprint": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
        },
        "devui_image_digest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
        },
        "devui_config_fingerprint": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
        }
      }
    },
    "component_inventory_digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "operator_evidence_digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "topology": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "owner",
          "placement_class",
          "evidence_digest",
          "state",
          "service_or_project",
          "source_identity_digest",
          "ingress_auth",
          "health_version",
          "deployment_owner",
          "migration_rollback",
          "source_identity",
          "observed_at"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
          },
          "placement_class": {
            "enum": [
              "vm102_resident_target",
              "external_dependency",
              "intentionally_non_runtime"
            ]
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "prepared",
              "deployed",
              "healthy",
              "external",
              "excluded"
            ]
          },
          "service_or_project": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
          },
          "source_identity_digest": {
            "type": "string",
            "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
          },
          "ingress_auth": {
            "enum": [
              "internal_authenticated",
              "external_source_owned",
              "excluded"
            ]
          },
          "health_version": {
            "enum": [
              "not_observed",
              "verified",
              "excluded"
            ]
          },
          "deployment_owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
          },
          "migration_rollback": {
            "enum": [
              "no_migration_restore_image_config",
              "builderops_governed_no_data_rewind",
              "external_source_owned",
              "excluded"
            ]
          },
          "source_identity": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_sha",
                  "image_digest",
                  "config_fingerprint"
                ],
                "properties": {
                  "source_sha": {
                    "type": "string",
                    "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
                  },
                  "image_digest": {
                    "type": "string",
                    "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
                  },
                  "config_fingerprint": {
                    "type": "string",
                    "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "version_digest"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.:-]{0,79}$"
                  },
                  "version_digest": {
                    "type": "string",
                    "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "placement_class": {
                  "const": "vm102_resident_target"
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "const": "prepared"
                },
                "health_version": {
                  "const": "not_observed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "placement_class": {
                  "const": "external_dependency"
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "const": "external"
                },
                "health_version": {
                  "const": "not_observed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "placement_class": {
                  "const": "intentionally_non_runtime"
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "const": "excluded"
                },
                "health_version": {
                  "const": "excluded"
                }
              }
            }
          }
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "service",
        "engine_id",
        "engine_context",
        "engine_socket",
        "process_owner",
        "bind_host",
        "port",
        "overview_path",
        "managed",
        "product_runtime_started",
        "no_dual_writer",
        "private_authenticated_ingress",
        "funnel",
        "migration",
        "rollback_owner"
      ],
      "properties": {
        "project": {
          "const": "builderops-devui"
        },
        "service": {
          "const": "devui"
        },
        "engine_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "engine_context": {
          "const": "builderops"
        },
        "engine_socket": {
          "const": "unix:///run/docker-builderops.sock"
        },
        "process_owner": {
          "const": "builderops"
        },
        "bind_host": {
          "const": "127.0.0.1"
        },
        "port": {
          "const": 8113
        },
        "overview_path": {
          "const": "/api/devui/overview"
        },
        "managed": {
          "const": true
        },
        "product_runtime_started": {
          "const": false
        },
        "no_dual_writer": {
          "const": true
        },
        "private_authenticated_ingress": {
          "const": true
        },
        "funnel": {
          "const": false
        },
        "migration": {
          "const": "none"
        },
        "rollback_owner": {
          "const": "builder-system-release-operator"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_topology",
        "source_image_config_verified",
        "read_only_sources",
        "listener_contract_verified"
      ],
      "properties": {
        "complete_topology": {
          "const": true
        },
        "source_image_config_verified": {
          "const": true
        },
        "read_only_sources": {
          "const": true
        },
        "listener_contract_verified": {
          "const": true
        }
      }
    },
    "verdict": {
      "const": "qualified"
    },
    "secret_material": {
      "const": "absent"
    },
    "gaps": {
      "const": []
    },
    "refusals": {
      "const": []
    },
    "evidence_fingerprint": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    }
  }
}
