{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tars_host_qualification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "evaluated_at",
    "evidence_fingerprints",
    "candidate_verdict",
    "live_qualified",
    "live_qualification_reason",
    "refusals"
  ],
  "properties": {
    "schema_version": {"const": "tars_host_qualification.v1"},
    "policy_version": {"const": "tars-builder-system-baseline.v1"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evidence_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "vm_102", "builderops"],
      "properties": {
        "host": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "vm_102": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "builderops": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidate_verdict": {"enum": ["pass", "fail"]},
    "live_qualified": {"const": false},
    "live_qualification_reason": {"const": "requires a governed live operations receipt"},
    "refusals": {"type": "array", "items": {"type": "string"}}
  }
}
