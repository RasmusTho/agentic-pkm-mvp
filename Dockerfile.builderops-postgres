FROM mirror.gcr.io/library/postgres:16-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4

# BuilderOps is rebuildable operational state. This image deliberately contains
# no backup client or recovery-egress configuration: deployment recreates from
# the repository, immutable image pins, configuration, and secret custody.
LABEL org.opencontainers.image.title="BuilderOps PostgreSQL" \
      org.opencontainers.image.source="https://github.com/RasmusTho/agentic-pkm-mvp" \
      org.opencontainers.image.durability="rebuildable"

# Docker Compose mounts file-backed secrets root-only. The upstream PostgreSQL
# entrypoint later runs init scripts as postgres, so stage only the app-role
# password into a postgres-only tmpfs for first initialization.
COPY scripts/builderops/postgres_entrypoint.sh /usr/local/bin/builderops-postgres-entrypoint.sh
RUN chmod 0755 /usr/local/bin/builderops-postgres-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/builderops-postgres-entrypoint.sh"]
