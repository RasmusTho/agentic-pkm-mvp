{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification closer terminal receipt",
  "type": "object",
  "properties": {
    "verdict": {"enum": ["delivered", "blocked", "needs_human", "retry"]},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "summary": {"type": "string"},
    "receipt_ids": {"type": "array", "items": {"type": "string"}},
    "retry_after": {"oneOf": [{"type": "string"}, {"type": "number"}]},
    "review_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"enum": ["repair", "review"]},
          "session_id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "reasoning_effort": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "finding_id": {"type": "string", "minLength": 1},
          "strongest": {"type": "boolean"}
        },
        "required": ["kind", "session_id", "capability", "reasoning_effort", "outcome"],
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "repair"}}},
            "then": {"required": ["finding_id"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["verdict", "head_sha", "summary", "receipt_ids"],
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "delivered"}}},
      "then": {"required": ["review_events"], "properties": {"review_events": {"minItems": 2}}}
    }
  ],
  "additionalProperties": false
}
