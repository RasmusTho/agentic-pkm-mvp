{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/events/index.embedding.created.schema.json",
  "title": "index.embedding.created",
  "type": "object",
  "required": ["event", "trace_id", "uuid", "metrics"],
  "properties": {
    "event": { "const": "index.embedding.created" },
    "trace_id": { "type": "string" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "required": ["vectors", "dim", "view"],
      "properties": {
        "vectors": { "type": "integer", "minimum": 0 },
        "dim": { "type": "integer", "minimum": 1 },
        "view": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
