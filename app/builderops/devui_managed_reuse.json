    "allowed_transformations": [
      {
        "transformation_id": "inherit-font-normalization",
        "kind": "local_system_font_no_egress_normalization",
        "source_ids": [
          "source-devui.css"
        ],
        "exact_rule": "Preserve the exact existing locally normalized font declarations and absent font import in the unchanged shipped devui.css. No new typography or egress normalization is introduced by the managed copy."
      },
      {
        "transformation_id": "managed-limitations-wrap",
        "kind": "layout_reflow",
        "source_ids": [
          "source-cockpit-wrap",
          "source-devui.css"
        ],
        "exact_rule": "The managed CSS is byte-for-byte the shipped devui.css followed only by .limitations li{overflow-wrap:break-word} and a newline. Transfer the accepted .rungs .r-val source-value wrapping declaration to complete limitation text. No other layout, token, visual, interaction or authority change."
      },
      {
        "transformation_id": "issue-5596-axis-container-reflow",
        "kind": "layout_reflow",
        "source_ids": [
          "source-devui.css"
        ],
        "exact_rule": "From the pre-#5596 shipped baseline at dd86e54221d04f9c730301ca734491b725c45be4, preserve the existing matrix tokens and grid, replace only mid-word wrapping with normal word boundaries, establish inline-size containment on the existing overview/focus containers, and move the existing matrix single-column fallback from the viewport media rule to max-width:40rem container scope. No new token, component, interaction, or authority behavior.",
        "source_anchors": [
          ".matrix{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--space-2)}",
          ".axis b,.axis span{display:block;overflow-wrap:anywhere}",
          ".overview-rail{min-width:0}",
          "@media (max-width:900px){.overview-grid,.focus-grid,.matrix{grid-template-columns:1fr}"
        ],
        "target_anchors": [
          ".matrix{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--space-2)}",
          ".axis b,.axis span{display:block;overflow-wrap:normal;word-break:normal}",
          ".overview-rail,.surface,.body{container-type:inline-size}",
          "@container (max-width:40rem){.matrix{grid-template-columns:1fr}}"
        ]
      },
      {
        "transformation_id": "issue-5596-evidence-single-render",
        "kind": "content_binding",
        "source_ids": [
          "source-overview.js"
        ],
        "exact_rule": "From the pre-#5596 shipped baseline at dd86e54221d04f9c730301ca734491b725c45be4, preserve each evidence object and its matrix(body, evidence) axis values; replace only the duplicate all-field rows(body, evidence) call with rows(body, evidence, true) so axis keys are omitted while evidence_id, claim, source_ref, captured_at, read_watermark and limitation remain rendered. No evidence field, computed value, fetch, navigation, or state behavior changes.",
        "source_anchors": [
          "function renderItem(parent, item) {",
          "matrix(body, evidence);",
          "rows(body, evidence);"
        ],
        "target_anchors": [
          "function renderItem(parent, item) {",
          "matrix(body, evidence);",
          "rows(body, evidence, true);"
        ]
      },
      {
        "transformation_id": "issue-5594-owner-language-disclosure",
        "kind": "interaction_binding",
        "source_ids": [
          "source-overview.js",
          "source-focus.js",
          "source-devui.css"
        ],
        "exact_rule": "Retain every server field and the #5596 evidence matrix/non-axis binding; render known owner-language labels and keep unknown scalar fields reachable, while placing raw subject/evidence identifiers and technical rows behind closed native details/summary controls. Reuse the existing Cockpit summary focus/hover grammar, with no new tokens, authority, persistence, egress, or effect behavior.",
        "source_anchors": [
          "<details class=\"card ${CARD_CLASS[item.band] || \"\"}\">",
          ".card>summary:focus-visible{outline:1px solid var(--cyan);outline-offset:-1px;box-shadow:var(--cyan-glow)}"
        ],
        "target_anchors": [
          "details.className = \"technical-disclosure\";",
          "function ownerRows(parent, value) {",
          ".technical-disclosure>summary:focus-visible{outline:1px solid var(--cyan);outline-offset:-1px;box-shadow:var(--cyan-glow)}"
        ]
      }
    ],
