FROM python:3.12-slim

ARG VCS_REF=unknown
ARG BUILT_AT=unknown

LABEL org.opencontainers.image.title="BuilderOps control plane" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.created="$BUILT_AT"

ENV VCS_REF=$VCS_REF \
    BUILT_AT=$BUILT_AT \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-builderops.txt ./
RUN pip install --no-cache-dir -r requirements-builderops.txt

COPY pyproject.toml ./
COPY app ./app
COPY config/platform/builderops_vm_rebuild_activation.v1.schema.json config/platform/devsystem_vm102_component_inventory.v1.schema.json config/platform/devui_vm102_runtime_qualification.v1.schema.json config/platform/devsystem_vm102_deploy.v1.schema.json config/platform/devsystem_vm102_health.v1.schema.json ./config/platform/
RUN pip install --no-cache-dir --no-deps . \
    && addgroup --system builderops \
    && adduser --system --ingroup builderops --home /nonexistent builderops

USER builderops
EXPOSE 8000

CMD ["uvicorn", "app.builderops.control_plane.service:production_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
