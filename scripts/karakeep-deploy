#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
source "$script_dir/lib/resolve_repo_python.sh"
python_bin="$(builderops_resolve_python "$repo_root")"
cd "$repo_root"
exec "$python_bin" -m app.ops.karakeep_deploy "$@"
