# Database connection used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/appdb

# Optional debugger bridge (fastapi/main.py checks these)
DEBUGPY=0
DEBUGPY_PORT=15678
DEBUGPY_WAIT=0

# API authentication (empty disables)
API_KEY=

# Rate limiting
RATE_LIMIT_ENABLED=0
RATE_LIMIT_DEFAULT=60/minute
# Optional Redis storage URI, e.g. redis://localhost:6379/0
RATE_LIMIT_REDIS_URL=

# Metrics
METRICS_ENABLED=0

# Vault location for Markdown output
VAULT_DIR=vault

# Chunk configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
