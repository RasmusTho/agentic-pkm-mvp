# ── Channel-specific vault overrides ─────────────────────────────────────────
# Each channel (dev, test, prod/stable) has its own vault root, DB, and layout.
# Create .env.dev.local (gitignored) for dev-specific settings that take
# precedence over .env. Use Docker Compose env-file format (KEY=VALUE); do NOT
# rely on shell sourcing for files whose paths contain spaces (e.g. iCloud paths
# under "Mobile Documents"). start_full_system.sh loads .env.<channel>.local
# safely via a Python-based parser when PKM_ENVIRONMENT/CHANNEL is set.
#
# Example .env.dev.local for a Niflheim iCloud vault:
#   PKM_ENVIRONMENT=dev
#   CHANNEL=dev
#   PKM_CHANNEL=dev
#   VAULT_ROOT=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/Niflheim
#   VAULT_SYSTEM_DIR_REL=⚙️ System
#   VAULT_INBOX_DIR_REL=📥 Inbox
#   VAULT_DESK_DIR_REL=🛠️ Workbench
#   CANVAS_ENABLED=0
#
# Then run: PKM_ENVIRONMENT=dev scripts/start_full_system.sh
# or:       make dev-start-full
#
# ─────────────────────────────────────────────────────────────────────────────
STORE_BACKEND=memory
LLM_PROVIDER=mock
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=nomic-embed-text:latest
EVAL_LLM_MODE=skip
EVAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
EVAL_LLM_API_KEY=sk-local
EVAL_LLM_MODEL=llama3.1:8b
#DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:15432/app
#DB_DSN=postgresql+psycopg://app:app@127.0.0.1:15432/app
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=sk-...
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
INDEX_PERSIST_PATH=tmp/index.jsonl
INDEX_PERSIST_LOAD=0
AUDIT_LOG_PATH=tmp/audit.jsonl
LLM_MAX_RETRIES=3
LLM_BASE_DELAY=0.1
RERANK_ENABLE=
RERANK_PROVIDER=none
RERANK_TOP_K=
