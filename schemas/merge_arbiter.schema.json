{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MergeArbiterDecision",
  "type": "object",
  "required": ["decision","similarity","confidence","scores","reason","policy_flags"],
  "properties": {
    "decision":{"enum":["A","B","HYBRID","ASK","ABSTAIN"]},
    "similarity":{"type":"number","minimum":0,"maximum":1},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "scores":{
      "type":"object",
      "required":["A","B"],
      "properties":{
        "A":{"type":"object","required":["total"],"properties":{"total":{"type":"number"}}},
        "B":{"type":"object","required":["total"],"properties":{"total":{"type":"number"}}}
      }
    },
    "reason":{"type":"string","maxLength":240},
    "hybrid":{
      "type":"object",
      "required":["take_from","carry_over_items"],
      "properties":{
        "take_from":{"enum":["A","B","MIX"]},
        "carry_over_items":{
          "type":"array",
          "items":{"type":"object","required":["type","text","from"],
                   "properties":{"type":{"enum":["link","fact","example","code"]},
                                 "text":{"type":"string"},
                                 "from":{"enum":["A","B"]}}}
        },
        "merged_text":{"type":"string"}
      }
    },
    "ask_prompt":{"type":"string"},
    "policy_flags":{"type":"array","items":{"type":"string"}}
  }
}
