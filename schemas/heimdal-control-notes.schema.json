{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.local/schemas/heimdal-control-notes.schema.json",
  "title": "Heimdal control-note schema manifest",
  "description": "Published client contract derived from app.heimdal.settings_notes.SETTINGS_NOTE_SPECS. The registry remains the runtime authority.",
  "schema_version": 1,
  "control_surface_root": "_heimdal",
  "note_kinds": [
    {"kind":"watchlist","relative_path":"watchlist.md","authority":"control_state","sections":[{"name":"watch","fields":[{"name":"watched","field_authority":"human_editable"},{"name":"last_synced","field_authority":"agent_authored"}]}]},
    {"kind":"never","relative_path":"never.md","authority":"control_state","sections":[{"name":"exclusions","fields":[{"name":"never","field_authority":"human_editable"},{"name":"last_enforced","field_authority":"agent_authored"}]}]},
    {"kind":"interests","relative_path":"interests.md","authority":"control_state","sections":[{"name":"weights","fields":[{"name":"weights","field_authority":"human_editable"},{"name":"observed_signal","field_authority":"agent_authored"},{"name":"confidence","field_authority":"agent_authored"},{"name":"evidence","field_authority":"agent_authored"},{"name":"decay","field_authority":"agent_authored"}]}]},
    {"kind":"steering_log","relative_path":"steering.log.md","authority":"append_only_log","sections":[{"name":"log","fields":[{"name":"entry_count","field_authority":"agent_authored"},{"name":"last_appended","field_authority":"agent_authored"}]}]},
    {"kind":"source","relative_path":"sources/{source_id}.md","authority":"control_state","sections":[{"name":"config","fields":[{"name":"source_id","field_authority":"human_editable"},{"name":"filters","field_authority":"human_editable"},{"name":"last_fetched","field_authority":"agent_authored"},{"name":"last_error","field_authority":"agent_authored"}]}]},
    {"kind":"consent","relative_path":"consent.md","authority":"control_state","sections":[{"name":"grants","fields":[{"name":"grants","field_authority":"agent_authored"},{"name":"last_ledger_sync","field_authority":"agent_authored"}]},{"name":"withhold_span_review","fields":[{"name":"withhold_span_review","field_authority":"agent_authored"}]},{"name":"retention_erasure","fields":[{"name":"retention_erasure","field_authority":"agent_authored"}]}]},
    {"kind":"settings","relative_path":"settings.md","authority":"control_state","sections":[{"name":"general","fields":[{"name":"options","field_authority":"human_editable"},{"name":"schema_version","field_authority":"agent_authored"}]},{"name":"retention","fields":[{"name":"retention_window_days","field_authority":"human_editable"},{"name":"screen_frame_retention_minutes","field_authority":"human_editable"},{"name":"last_enforced_at","field_authority":"agent_authored"}]}]},
    {"kind":"attention_day","relative_path":"attention/{date}.md","authority":"durable_slice","sections":[{"name":"summary","fields":[{"name":"overrides","field_authority":"human_editable"},{"name":"counts","field_authority":"agent_authored"},{"name":"reasons","field_authority":"agent_authored"}]}]},
    {"kind":"entity_review","relative_path":"entities/review.md","authority":"control_state","sections":[{"name":"queue","fields":[{"name":"decisions","field_authority":"human_editable"},{"name":"pending","field_authority":"agent_authored"}]}]},
    {"kind":"device","relative_path":"devices/{device_id}.md","authority":"durable_slice","sections":[{"name":"identity","fields":[{"name":"device_id","field_authority":"human_editable"},{"name":"label","field_authority":"human_editable"},{"name":"consent_grant_ref","field_authority":"human_editable"}]},{"name":"history","fields":[{"name":"capture_gap_log","field_authority":"agent_authored"},{"name":"last_known_snapshot","field_authority":"agent_authored"}]}]}
  ]
}
