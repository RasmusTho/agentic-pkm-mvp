{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureTriageBundle",
  "type": "object",
  "required": ["capture_id", "summary", "entities", "tasks", "decisions", "raw"],
  "properties": {
    "capture_id": { "type": "string" },
    "summary": { "type": "string" },
    "signal_quality": { "type": "string" },
    "areas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "text"],
        "properties": {
          "uuid": { "type": "string" },
          "owner": { "type": "string" },
          "text": { "type": "string" },
          "deadline": { "type": "string" },
          "status": { "type": "string" },
          "importance": { "type": "string" },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "entity_uuid": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uuid", "text"],
        "properties": {
          "uuid": { "type": "string" },
          "text": { "type": "string" },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "entity_uuid": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "entity_uuid"],
        "properties": {
          "name": { "type": "string" },
          "entity_uuid": { "type": "string" },
          "entity_type": { "type": "string" },
          "signal_quality": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "raw": { "type": "string" }
  }
}
