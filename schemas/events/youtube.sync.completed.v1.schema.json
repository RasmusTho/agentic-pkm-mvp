{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.local/schemas/events/youtube.sync.completed.v1.schema.json",
  "title": "youtube.sync.completed payload (v1)",
  "description": "Successful per-source YouTube poll receipt. Idempotency key basis: (topic, binding_id, run_id).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "binding_id",
    "run_id",
    "discovered",
    "enqueued",
    "deduped",
    "not_modified",
    "duration_ms",
    "quota_units_spent"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "discovered": { "type": "integer", "minimum": 0 },
    "enqueued": { "type": "integer", "minimum": 0 },
    "deduped": { "type": "integer", "minimum": 0 },
    "not_modified": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "quota_units_spent": { "type": "integer", "minimum": 0 }
  }
}
